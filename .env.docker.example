# ── 我们一家 · Docker Compose 环境变量 ───────────────────
# 用法：cp .env.docker.example .env
#
# docker compose 会自动读取同目录的 .env 文件，用于替换 docker-compose.yml 里的 ${...}。
# 不创建这个文件也能跑，下面每项都写了默认值。
#
# 注意：这个文件只影响 compose 的端口映射与容器环境变量。
# 数据库路径、图片目录在容器内固定为 /data/*（由 compose 指定），不要在这里改。

# 宿主机监听的端口（v4.3.1 起默认 3455，旧版本是 3000）。
# 改成 8080 就用 http://服务器IP:8080 访问；留空则用 3455。
PORT=3455

# 绑定地址。0.0.0.0 = 局域网/公网均可访问；
# 配了 Nginx 反代时改成 127.0.0.1，只让本机访问，更安全
BIND_ADDR=0.0.0.0

# 站点名称（v1.8.0 起可由管理员自定义）**不在这里配置**。
# 唯一入口：登录管理员账号 →「我的」→「家庭设置」→「基础」→ 站点名称。
# 名称存在数据库里（settings.site_name，留空 = 默认的「我们一家」），
# 同时作用于标题栏、登录页、页脚和提醒/通知邮件。
# 在这里写 FAMILY_NAME=xxx 不会生效（v1.6.0 起该环境变量已废弃，写了只是被忽略）。

# 登录态有效期（小时）。24 = 登录一次后 1 天内再打开无需登录（每次访问自动续期）
SESSION_TTL_HOURS=24

# 单个账号最多同时保留几台设备的登录。超过后最旧的会话被挤掉
MAX_SESSIONS_PER_USER=10

# 单张图片最大体积（MB）。v1.5.0 起默认 10 —— 手机原图常在 5-8MB，
# 退回 5 会让分享原图反复失败（这正是「图片上传失败」最常见的成因）
MAX_UPLOAD_MB=10

# 记录本单个附件最大体积（MB）。文档 / 压缩包比图片大，所以单独一个上限
MAX_FILE_MB=20

# 单段视频最大体积（MB，v1.9.0）。比图片大一个量级，因为手机随手拍的一段就是十几 MB。
# 上限同时受反代（Nginx client_max_body_size）与容器内存影响：
# 视频是以 base64 塞在 JSON 请求体里上传的，实际请求体约为这里数值的 1.4 倍。
# 调大前先确认反代那边也放开了，否则会看到一个「无响应」的 413。
MAX_VIDEO_MB=50

# 是否允许自助注册。全家都注册完之后改成 0，防止陌生人注册
ALLOW_REGISTER=1

# 1 = 信任反向代理的 X-Forwarded-Proto（只在真的走 https 时才给 Cookie 加 Secure）
# 直接裸 HTTP 访问时保持 1 也没有副作用；若代理配置异常导致登录反复跳回登录页，可改为 0
TRUST_PROXY=1

# 容器时区，影响日志时间
TZ=Asia/Shanghai

# 待办提醒的时区偏移（分钟）。480 = 东八区（北京时间），540 = 东九区，0 = UTC。
# 待办上的日期与时间按这个偏移换算成绝对时刻，因此容器时区设错也不会让提醒跑偏。
# 一般不用改；也可以登录后在「我的 → 家庭设置」里直接选。
TZ_OFFSET_MINUTES=480

# ── 千问（阿里云百炼 DashScope）API Key（可选）─────────────
# 用途：**只用于记账的「传小票 / 截图」识别**（一句话文字记账自 v4.2.0 起已改为
#       完全本地解析，不需要 Key；截图识别的模型也不再自动获取，由管理员在设置页手填）。
#       不配也能用文字记账，只是聊天窗里的 📷 按钮会置灰并写明原因。
#
# ★ 推荐做法：什么都不在这里填，改成登录管理员账号 →「记账 → 设置 → 截图识别」里填。
#   好处：① 密钥存到数据库、不落在 compose 文件与宿主机环境里；
#         ② 改完立即生效，不用 `docker compose up -d` 重启；
#         ③「本月已用 AI 次数 / token」也显示在同一块。
#   下面这行只是**兜底**：数据库里没配时才读环境变量。
#
# v4.24.0：AI 识别走通用 OpenAI 兼容平台（接口地址 + API Key + 模型 ID，
#   推荐直接在网页里配置）。这里只是数据库没配时的兜底。
AI_API_KEY=
# 留空 = 用出厂默认端点（OpenAI 官方兼容地址）；自建/其它平台时填到 /v1 这一级
AI_BASE_URL=
AI_VL_MODEL=
# 老配置兼容：qwen 时代的密钥仍被读取（接口地址默认指向百炼兼容端点）
DASHSCOPE_API_KEY=
